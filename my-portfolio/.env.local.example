# Firebase client-side configuration
# These are safe to expose publicly.
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_storage_bucket"

# Firebase server-side (Admin SDK) configuration
# IMPORTANT: This is a secret and should NEVER be committed to Git.
# This is just a placeholder to remind you what's needed.
# The actual service account key should be stored as a secret in your hosting provider (e.g., Vercel).
FIREBASE_SERVICE_ACCOUNT="path/to/your/serviceAccountKey.json"
